NexusWindow
  id: nexusLauncher
  size: 254 600
  padding-top: 16
  text:
  Panel
    id: brand
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 30
    height: 34
    phantom: true
    Label
      id: primary
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 0
      font: pVerdana Bold-11px
      width: 40
      height: 24
      text: CWEL
      text-align: left-center
      color: #eef5ff
      phantom: true
    Label
      id: accent
      anchors.left: primary.right
      anchors.verticalCenter: parent.verticalCenter
      width: 34
      height: 24
      text: BOT
      text-align: left-center
      font: pVerdana Bold-11px
      color: #ef4353
      phantom: true
  UIWidget
    id: line
    anchors.top: brand.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 0
    margin-top: 0
    phantom: true
  Panel
    id: entries
    anchors.top: line.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    layout:
      type: verticalBox
      spacing: 4
