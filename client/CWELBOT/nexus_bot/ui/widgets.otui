    anchors.left: parent.left
    anchors.top: type.bottom
    margin-top: 3
    width: 94
  NexusNumberInput
    id: value
    anchors.left: operator.right
    anchors.top: operator.top
    margin-left: 4
    width: 65
  NexusNumberInput
    id: value2
    anchors.left: value.right
    anchors.top: operator.top
    anchors.right: parent.right
    margin-left: 4

NexusConditionGroup < UIWidget
