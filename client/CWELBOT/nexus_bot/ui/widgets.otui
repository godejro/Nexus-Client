NexusButton < UIButton
  font: verdana-11px-antialised
  height: 28
  color: #c9d9ed
  image-source: @NEXUS_ASSETS@/button
  image-border: 10
  text-align: center
  focusable: false
  $hover !disabled:
    image-source: @NEXUS_ASSETS@/hover
    color: #ffffff
  $on:
    image-source: @NEXUS_ASSETS@/selected
  $disabled:
    color: #536780

NexusAccentButton < NexusButton
  color: #90cbff

NexusIconButton < NexusButton
  size: 26 26

NexusCloseButton < NexusIconButton
  color: #fa6275
  $hover !disabled:
    color: #fa6275
  $pressed:
    color: #fa6275

NexusToggle < NexusButton
  size: 44 24
  text: OFF
  color: #8394ac
  $on:
    text: ON
    color: #72e5c4
    image-source: @NEXUS_ASSETS@/selected

NexusTextInput < UITextEdit
  font: verdana-11px-antialised
  height: 28
  color: #e2eeff
  background-color: #091423
  border-width: 1
  border-color: #2a405b
  padding: 5
  focusable: true
  $focus:
    border-color: #5ba4ef

NexusSearchBox < NexusTextInput

NexusScrollPanel < UIScrollArea
  phantom: false
  auto-focus: first
  @onSetup: |
    self.onMouseWheel=function(self, pos, direction)
      local offset=self:getVirtualOffset()
      local maximum=math.max(0,self:getChildrenRect().height-self:getPaddingRect().height)
      offset.y=math.max(0,math.min(maximum,offset.y+(direction==1 and -48 or 48)))
      self:setVirtualOffset(offset)
      return true
    end

NexusComboBox < UIComboBox
  font: verdana-11px-antialised
  height: 28
  color: #d7e7fb
  image-source: @NEXUS_ASSETS@/button
  image-border: 10
  padding-left: 5
  padding-right: 10

NexusComboBoxPopupMenu < PopupMenu
  image-source: @NEXUS_ASSETS@/surface
  image-border: 12
  background-color: #0e192b
  padding: 6

NexusComboBoxPopupMenuButton < PopupMenuButton
  image-source:
  background-color: #0e192b
  color: #d7e7fb
  height: 24
  $hover:
    background-color: #193653

NexusNumberInput < UITextEdit
  font: verdana-11px-antialised
  height: 28
  focusable: true
  background-color: #091423
  border-width: 1
  border-color: #2a405b
  color: #e2eeff
  padding: 4
  @onSetup: |
    NexusBot.UI.configureNumber(self)

NexusScrollThumb < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 8 16
  image-source: @NEXUS_ASSETS@/scroll-thumb
  image-border: 4
  image-color: #438fe3
  $hover:
    image-color: #73b6ff
  $pressed:
    image-color: #a2d1ff

NexusVerticalScrollBar < UIScrollBar
  orientation: vertical
  size: 8 40
  background-color: #091423
  pixels-scroll: true
  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 8 0
    visible: false
  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 8 0
    visible: false
  NexusScrollThumb

NexusSlider < UIScrollBar
  orientation: horizontal
  height: 14
  background-color: #091423
  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 0 14
    visible: false
  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 0 14
    visible: false
  NexusScrollThumb
    size: 14 14

NexusTableHeader < UIWidget
  height: 24

NexusTableHeaderLabel < NexusMutedLabel

NexusRuleRow < UIWidget
