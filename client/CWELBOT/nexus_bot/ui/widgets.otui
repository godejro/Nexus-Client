  $on:
    image-source: @NEXUS_ASSETS@/selected
  UIWidget
    id: state
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 3
    margin: 9 0 9 4
    background-color: #536780
    phantom: true
  Label
    id: actionLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: 8 9 0 14
    height: 18
    color: #edf4ff
    phantom: true
  NexusMutedLabel
    id: conditionLabel
    anchors.left: actionLabel.left
    anchors.right: parent.right
    anchors.top: actionLabel.bottom
    margin-right: 8
    font: verdana-11px-antialised

NexusProfileRow < UIWidget
