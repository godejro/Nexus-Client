
SpecialConditionLabelSettings < UIWidget
  height: 20

  UIWidget
    id: icon
    size: 10 10
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5

  Label
    id: label
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    color: #dfdfdf

  CheckBox
    id: showInHudCheckBox
    size: 12 12
    anchors.right: showInBarCheckBox.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 80
    image-source: /images/ui/checkbox
    image-clip: 0 0 12 12

  CheckBox
    id: showInBarCheckBox
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 50
    image-source: /images/ui/checkbox
    image-clip: 0 0 12 12

OptionsCategory < UIWidget
  size: 118 22
  image-source: /images/ui/1pixel_down_frame
  image-border: 5
  UIWidget
    id: Button
    height: 20
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    margin-left: 1
    margin-right: 1
    image-source: /images/ui/button-grey-up
    image-border: 5
    opacity: 1.0
    $pressed:
      image-source: /images/ui/button-grey-down
    $checked:
      image-source: /images/ui/button-grey-down
    UIWidget
      id: Icon
      size: 13 13
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 7
      phantom: true
    Label
      id: Title
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      text-align: center
      text-auto-resize: true
      phantom: true
      !text: tr('General Stats')
      color: #ffffff
      font: cipsoftFont
    UIWidget
      id: Arrow
      size: 7 7
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      phantom: true
      image-source: /images/ui/icon-arrow7x7-down
      visible: false

OptionsSearchResult < UIWidget
  height: 18
  text-align: left
  text-offset: 6 0
  color: #c0c0c0ff
  focusable: false
  $hover:
    background-color: #ffffff22
    color: #ffffff

OptionCheckBox < QtCheckBox
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  color: #c0c0c0ff
  @onCheckChange: modules.client_options.setOption(self:getId(), self:isChecked())

OptionCheckBoxMarked < OptionCheckBox
  UIWidget
    id: toolTipWidget
    image-source: /images/icons/show_gui_help_grey
    size: 12 12  
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

OptionScaleScroll < Label
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  text-align: left
  text-offset: 18 0
  color: #c0c0c0ff

  HorizontalQtScrollBar
    id: valueBar
    step: 1
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    width: 174
    @onValueChange: |
      modules.client_options.setOption(self:getParent():getId(), self:getValue())

OptionLabelMarked < Label
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  text-align: left
  text-offset: 18 0
  color: #c0c0c0ff

  UIWidget
    id: toolTipWidget
    image-source: /images/icons/show_gui_help_grey
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

OptionScaleScrollMarked < Label
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  text-align: left
  text-offset: 18 0
  color: #c0c0c0ff

  UIWidget
    id: toolTipWidget
    image-source: /images/icons/show_gui_help_grey
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

  HorizontalQtScrollBar
    id: valueBar
    step: 1
    anchors.right: toolTipWidget.left
    anchors.verticalCenter: toolTipWidget.verticalCenter
    margin-right: 10
    width: 174
    @onValueChange: |
      modules.client_options.setOption(self:getParent():getId(), self:getValue())

MainWindow
  id: optionsWindow
  size: 686 534
  anchors.centerIn: parent
  visible: false
  draggable: true
  icon-rect: 4 4 16 16

  image-source: /images/ui/window_new
  image-border: 4
  image-border-top: 16
  image-border-bottom: 4
  &minimizedHeight: 17
  draggable: true

  $on:
    image-border-bottom: 2
  @onEnter: modules.client_options.onWindowEnter()
  @onEscape: modules.client_options.hide()
  $mobile:
    size: 500 380

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 2
    margin-bottom: 15

  Label
    !text: tr('Options')
    font: verdana-11px-antialised
    margin-top: -35
    text-align: top
    anchors.top: parent.top

    anchors.left: parent.left
    anchors.right: parent.right
    opacity: 0.5

  UIWidget
    id: optionsTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: separator.bottom
    margin-left: 1
    margin-top: -10
    margin-bottom: 10
    image-border: 3
    image-source: /images/ui/2pixel_up_frame_borderimage_dark
    size: 128 423

  QtPanel
    id: optionsTabContent
    anchors.top: optionsTabBar.top
    anchors.left: optionsTabBar.right
    anchors.right: parent.right
    anchors.bottom: separator.bottom
    margin-left: 10
    margin-bottom: 10

  UIWidget
    id: searchResults
    anchors.fill: optionsTabContent
    background-color: #2a2a2aff
    border-width: 1
    border-color: #00000077
    visible: false
    padding: 4

    Label
      id: searchHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      color: #909090ff
      text-align: left

    UIScrollArea
      id: searchList
      anchors.top: searchHeader.bottom
      anchors.left: parent.left
      anchors.right: searchScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 4
      vertical-scrollbar: searchScrollBar
      layout:
        type: verticalBox

    VerticalScrollBar
      id: searchScrollBar
      anchors.top: searchHeader.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 4
      step: 18
      pixels-scroll: true

  TextEdit
    id: optionsSearch
    size: 180 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: -8
    margin-left: 1
    !placeholder: tr('Search...')
    placeholder-color: #6E706F
    @onTextChange: modules.client_options.searchOptions(self:getText())

  QtButton
    id: optionsSearchClear
    !text: 'X'
    size: 20 20
    anchors.left: optionsSearch.right
    anchors.bottom: parent.bottom
    margin-bottom: -8
    margin-left: 3
    !tooltip: tr('Clear search')
    @onClick: modules.client_options.clearSearch()

  QtButton
    id: optionsCancel
    !text: tr('Cancel')
    size: 56 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: -8
    @onClick: modules.client_options.cancelOptions()

  QtButton
    id: optionsApply
    !text: tr('Apply')
    size: 56 20
    anchors.right: optionsCancel.left
    anchors.bottom: parent.bottom
    margin-bottom: -8
    margin-right: 6
    @onClick: modules.client_options.applyOptions()

  QtButton
    id: optionsOk
    !text: tr('Ok')
    size: 56 20
    anchors.right: optionsApply.left
    anchors.bottom: parent.bottom
    margin-bottom: -8
    margin-right: 6
    @onClick: |
      modules.client_options.saveOptions()
      modules.client_options.hide()
