RewardWallDay < Panel
  size: 68 98
  RewardButton3
    id: button
    size: 68 68
    anchors.top: parent.top
    anchors.left: parent.left
  GoldLabel2
    id: reward
    size: 68 22
    anchors.top: button.bottom
    anchors.left: parent.left
    margin-top: 4

MainWindow
  id: rewardWallWindow
  text: Reward Wall
  size: 590 560
  Panel
    id: historyPanel
    visible: false
    TextListWithScroll
      id: historyList
      anchors.fill: parent
  FlatPanel
    id: restingAreaPanel
    text: Resting Area Bonuses
    text-align: top
    padding-top: 22
    Panel
      id: restingAreaInfo
      UIWidget
        id: rewardStreakIcon
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 12
        size: 70 44
        image-source: /game_rewardwall/images/icon-rewardstreak-default
        text: 0
      Label
        id: timeLeft
        anchors.top: rewardStreakIcon.bottom
        anchors.left: parent.left
        size: 90 24
        text-align: center
      GoldLabel2
        id: restingAreaGold
        anchors.top: timeLeft.bottom
        anchors.left: parent.left
        size: 90 20
    Panel
      id: bonusIcons
      layout:
        type: horizontalBox
        spacing: 4
      imgBonuses
        id: bonusIcon1
        icon-clip: 0 0 64 64
      imgBonuses
        id: bonusIcon2
        icon-clip: 64 0 64 64
      imgBonuses
        id: bonusIcon3
        icon-clip: 128 0 64 64
      imgBonuses
        id: bonusIcon4
        icon-clip: 192 0 64 64
      imgBonuses
        id: bonusIcon5
        icon-clip: 256 0 64 64
      imgBonuses
        id: bonusIcon6
        icon-clip: 320 0 64 64
    Label
      id: streakWarning
      text-wrap: true
