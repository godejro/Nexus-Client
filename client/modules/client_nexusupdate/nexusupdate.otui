MainWindow
  id: nexusUpdateWindow
  size: 440 190
  @onEscape: self:hide()
  UIWidget
    id: heading
    image-source: /modules/client_nexusupdate/updating_title
    size: 350 49
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -4
    phantom: true
  Label
    id: message
    anchors.top: heading.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 16
    text-align: center
    color: #9fb4d6
  UIWidget
    id: progress
    anchors.top: message.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 6
    margin-right: 6
    height: 22
    image-source: /modules/client_nexusupdate/updating_track
    image-border: 7
    phantom: true
    UIWidget
      id: fill
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin: 2
      width: 0
      image-source: /modules/client_nexusupdate/updating_fill
      image-border: 5
      clipping: true
      phantom: true
      UIWidget
        id: sheen
        image-source: /modules/client_nexusupdate/updating_sheen
        size: 48 18
        anchors.top: parent.top
        anchors.left: parent.left
        phantom: true
    Label
      id: percent
      anchors.fill: parent
      text-align: center
      font: verdana-11px-rounded
      color: #ffffff
      text: 0%
      phantom: true
  Button
    id: close
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 90
    text: Later
    @onClick: self:getParent():hide()
  Button
    id: update
    anchors.bottom: parent.bottom
    anchors.right: close.left
    margin-right: 8
    width: 150
    text: Check for updates
